{
  "name": "workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "typecheck": "tsc -p server && tsc -p client",
    "test": "npm test --workspace server && npm test --workspace client"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
