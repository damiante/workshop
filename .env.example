# Copy to .env for local development (`npm run dev:server` reads it).
WORKSHOP_PASSWORD=change-me-to-a-long-password
WORKSHOP_SECRET_KEY=change-me
DATA_DIR=./data
TZ=Australia/Melbourne
# Workshop's address as you open it. Used for screenshot links in pull requests.
# WORKSHOP_PUBLIC_URL=http://localhost:5173
# Build the agent image locally first: podman build --target base -t workshop-agent:dev agent
# WORKSHOP_AGENT_IMAGE=localhost/workshop-agent:dev
# WORKSHOP_AGENT_BROWSER_IMAGE=localhost/workshop-agent-browser:dev
